{
  "name": "goban-dojo",
  "version": "1.0.0",
  "private": true,
  "description": "Apprendre le go en rejouant ses kifu et les parties de Shūsaku, en essayant ses variantes et en affrontant Leela Zero.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm data:build && vite build",
    "preview": "vite preview",
    "data:fetch": "node scripts/fetch-sources.ts",
    "data:build": "node scripts/build-data.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "sbom": "node scripts/sbom.ts",
    "audit:deps": "pnpm audit --prod",
    "check": "pnpm data:build && pnpm typecheck && pnpm lint && pnpm arch && pnpm format:check && pnpm test && pnpm audit:deps && vite build && pnpm e2e",
    "arch": "depcruise --config .dependency-cruiser.cjs src scripts tests"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "@pixiv/three-vrm": "3.5.5",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "motion": "14.14.0",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
